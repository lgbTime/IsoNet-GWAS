#!/usr/bin/env bash
# =============================================================================
# IsoNet-GWAS configuration file
# -----------------------------------------------------------------------------
# Source this file before running any step:
#       source config.env
# or simply run ./00_master_pipeline.sh which sources it for you.
#
# Every variable can also be overridden from the shell environment, e.g.
#       PLINK=/opt/plink/plink ./00_master_pipeline.sh
# =============================================================================

# ---------------------------------------------------------------------------
# 1. External tools (used by gwasor.py, run.sh and the master pipeline)
# ---------------------------------------------------------------------------
export PLINK="${PLINK:-plink}"                       # PLINK 1.9 binary
export EMMAX="${EMMAX:-emmax-intel64}"               # EMMAX association binary
export EMMAX_KIN="${EMMAX_KIN:-emmax-kin-intel64}"   # EMMAX kinship binary
export FLASHPCA="${FLASHPCA:-flashpca2}"             # flashpca2 binary (PCA, optional)
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export QQNORM_R="${QQNORM_R:-$CONFIG_DIR/utilities/qqnorm_pheno.R}"  # phenotype qq-norm (base-R only, bundled in utilities)
export PYTHON="${PYTHON:-python3}"
export RSCRIPT="${RSCRIPT:-Rscript}"

# ---------------------------------------------------------------------------
# 2. Optional AI enrichment (Layer-1 / Layer-2)
#    Leave DEEPSEEK_API_KEY empty to skip the AI module-calling step.
# ---------------------------------------------------------------------------
export DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-}"      # e.g. sk-xxxxxxxx
export DEEPSEEK_MODEL="${DEEPSEEK_MODEL:-deepseek-chat}"
export DEEPSEEK_API_BASE="${DEEPSEEK_API_BASE:-https://api.deepseek.com/v1}"

# ---------------------------------------------------------------------------
# 3. Project data (edit these for your dataset)
# ---------------------------------------------------------------------------
# Top-level directory holding input data files (see README for the file list).
export DATA_DIR="${DATA_DIR:-$CONFIG_DIR/data}"

# --- Step 1: isoform genetic map -------------------------------------------
# Per-chromosome isoform BED files (isoform TSS/TES coordinates)
export BED_DIR="${BED_DIR:-$DATA_DIR/bed}"
# Isoform genetic map (generated by Step 1a; required by Step 3 for .qqman
# conversion/Manhattan plotting, and by Step 1b for PAV->PED)
export MAPFILE="${MAPFILE:-$DATA_DIR/map/genetic_map.map}"
# Isoform PAV matrix: rows = isoforms, columns = XLOC,refGene,classCode + samples
export PAV_MATRIX="${PAV_MATRIX:-$DATA_DIR/pav.xls}"
# Output prefix of the PAV PLINK dataset produced by step 1
export PAV_PREFIX="${PAV_PREFIX:-lettome}"

# --- Step 2: plus-marker genotype ------------------------------------------
# Optional extra marker VCFs merged into the PAV genotype (gene-body SVs, GLK PAV, ...)
export GENE_BODY_VCF="${GENE_BODY_VCF:-$DATA_DIR/extracted.gene_body.filtered_num_chr.vcf}"
export GLK_PAV_VCF="${GLK_PAV_VCF:-$DATA_DIR/GLK.PAV.txt.GT.vcf}"
# Output prefix of the merged genotype dataset
export GT_PREFIX="${GT_PREFIX:-lettome_iso_plus_gene_variants}"

# --- Step 3: GWAS -----------------------------------------------------------
# Space-separated list of trait names (each must be a phenotype file <trait>)
export TRAITS="${TRAITS:-all_Carotenoids all_chlorophy_a+b all_chlorophy_b all_Total_pigment}"
# -log10 significance threshold used for the Manhattan plot red line
export SIG="${SIG:-5}"

# --- Step 4/5: network layers ------------------------------------------------
export GTF="${GTF:-$DATA_DIR/pop240GTF2ref.combined.gtf}"           # StringTie combined GTF
export GFF="${GFF:-$DATA_DIR/Lsat_Salinas_v11_genomic.gff}"         # reference genome GFF
# eggNOG-mapper hit table for isoforms + genes (see README "eggNOG annotation")
export ANNOTATIONS="${ANNOTATIONS:-$DATA_DIR/isoform_and_gene.emapper.annotations}"
# GO term description table — provided in resources/go.tab (from eggNOG-mapper data)
export GO_TAB="${GO_TAB:-$CONFIG_DIR/resources/go.tab}"
export QQMAN_DIR="${QQMAN_DIR:-}"                     # directory with *.pheno.qqman GWAS results (defaults to $DATA_DIR/qqman in the runners)
export QQMAN_PATTERN="${QQMAN_PATTERN:-*.pheno.qqman}"
export EXPRESSION_MATRIX="${EXPRESSION_MATRIX:-$DATA_DIR/Pop_isoform_TPM_by_compareGTF.txt}"  # isoform TPM matrix
export P_VALUE_THRESHOLD="${P_VALUE_THRESHOLD:-1e-5}"
